#-------------------------------------------------------------------------------
# Catppuccin Mocha for btop
#
# Hand-built from the official Catppuccin Mocha palette rather than vendored
# from catppuccin/btop, so the hexes here match the same palette the rest of
# this setup uses (ghostty, tmux, nvim, yazi, borders, sketchybar).
#
# btop only reads themes from $XDG_CONFIG_HOME/btop/themes and its install
# prefix; the Homebrew formula ships no Catppuccin variant, which is why this
# file is tracked in the dotfiles repo instead of installed by bootstrap.
#-------------------------------------------------------------------------------

# Main background, empty for terminal default
theme[main_bg]="#1e1e2e"

# Main text color
theme[main_fg]="#cdd6f4"

# Title color for boxes
theme[title]="#cdd6f4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#89b4fa"

# Background color of selected item in processes box
theme[selected_bg]="#45475a"

# Foreground color of selected item in processes box
theme[selected_fg]="#89b4fa"

# Color of inactive/disabled text
theme[inactive_fg]="#7f849c"

# Color of text appearing on top of graphs
theme[graph_text]="#f5e0dc"

# Background color of the percentage meters
theme[meter_bg]="#45475a"

# Misc colors for processes box including mini cpu graphs, details memory graph
theme[proc_misc]="#f5e0dc"

# CPU box outline color
theme[cpu_box]="#cba6f7"

# Memory/disks box outline color
theme[mem_box]="#a6e3a1"

# Net down/up box outline color
theme[net_box]="#eba0ac"

# Processes box outline color
theme[proc_box]="#89b4fa"

# Box divider line and small boxes line color
theme[div_line]="#6c7086"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="#94e2d5"
theme[cpu_mid]="#74c7ec"
theme[cpu_end]="#b4befe"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#cba6f7"
theme[free_mid]="#b4befe"
theme[free_end]="#89b4fa"

# Mem/Disk cached meter (Sky -> Sapphire -> Blue)
theme[cached_start]="#89dceb"
theme[cached_mid]="#74c7ec"
theme[cached_end]="#89b4fa"

# Mem/Disk available meter (Yellow -> Peach -> Maroon)
theme[available_start]="#f9e2af"
theme[available_mid]="#fab387"
theme[available_end]="#eba0ac"

# Mem/Disk used meter (Green -> Teal -> Sky)
theme[used_start]="#a6e3a1"
theme[used_mid]="#94e2d5"
theme[used_end]="#89dceb"

# Download graph colors (Peach -> Maroon -> Red)
theme[download_start]="#fab387"
theme[download_mid]="#eba0ac"
theme[download_end]="#f38ba8"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#a6e3a1"
theme[upload_mid]="#94e2d5"
theme[upload_end]="#89b4fa"

# Process box color gradient for threads, mem and cpu usage (Blue -> Mauve -> Pink)
theme[process_start]="#89b4fa"
theme[process_mid]="#cba6f7"
theme[process_end]="#f5c2e7"
