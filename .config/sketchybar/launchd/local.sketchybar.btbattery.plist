<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. bootstrap.sh substitutes __HOME__ and writes the result to
  ~/Library/LaunchAgents/. launchd does no variable expansion in
  ProgramArguments, so the path has to be baked in at install time.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.sketchybar.btbattery</string>

  <!-- launchd, not sketchybar, must be the parent: see btbattery-poll.sh. -->
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.config/sketchybar/bin/btbattery-poll.sh</string>
  </array>

  <!-- A keyboard battery moves over weeks; five minutes is already generous. -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
