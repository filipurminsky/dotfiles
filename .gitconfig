; Identity lives in ~/.gitconfig.local (untracked) so this file can be public.
[include]
	path = ~/.gitconfig.local
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
	; delta highlights syntax through bat's theme engine. Naming the theme here
	; rather than relying on $BAT_THEME keeps diffs on-palette when git runs the
	; pager outside an interactive shell (lazygit popups, IDE terminals, hooks),
	; where exports.zsh has never been sourced.
	syntax-theme = Catppuccin Mocha
[merge]
	conflictStyle = zdiff3
	tool = diffbandit
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = current
	followTags = true
[fetch]
	prune = true
[rebase]
	autostash = true
	updateRefs = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
	tool = diffbandit
	colorMoved = default
[commit]
	verbose = true
[branch]
	sort = -committerdate
[column]
	ui = auto
[mergetool]
	prompt = false
	keepBackup = false
; diffbandit.nvim reads the conflict stages from the index and `git add`s the
; file on :w. trustExitCode stays off because nvim exits 0 even when you close
; without resolving, so git asks whether the merge succeeded.
[mergetool "diffbandit"]
	cmd = nvim-diffbandit merge "$MERGED"
	trustExitCode = false
[difftool]
	prompt = false
; git passes directories here when called with --dir-diff (lazygit's <c-t> does
; that for folder nodes); the wrapper picks the folder view in that case.
[difftool "diffbandit"]
	cmd = nvim-diffbandit diff "$LOCAL" "$REMOTE"
[alias]
	conflicts = !nvim -c DiffBanditGit
