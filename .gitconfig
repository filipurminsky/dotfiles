; Identity lives in ~/.gitconfig.local (untracked) so this file can be public.
[include]
	path = ~/.gitconfig.local
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
[merge]
	conflictStyle = zdiff3
	tool = nvimdiff
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = current
	followTags = true
[fetch]
	prune = true
[rebase]
	autostash = true
	updateRefs = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
	tool = nvimdiff
	colorMoved = default
[commit]
	verbose = true
[branch]
	sort = -committerdate
[column]
	ui = auto
[mergetool]
	prompt = false
	keepBackup = false
[difftool]
	prompt = false
[alias]
	conflicts = !nvim -c DiffviewOpen
